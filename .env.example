# Copy to .env.development or .env.production (both gitignored) and fill in real values.
# See README.md for what each one does.

VITE_HOST_URL="factoryflow.local"
VITE_HOST_PORT=3000
VITE_APP_URL="http://app.factoryflow.local:3001"
VITE_API_URL="http://api.factoryflow.local:3001"
VITE_DOCUMENTATION_URL="https://factoryflow.gitbook.io/factoryflow/"

# Gateway download modal (see "Gateway download" in README.md)
VITE_TURNSTILE_SITE_KEY=
VITE_DOWNLOAD_API_URL="https://downloads.factoryflow.io"
VITE_SHOW_GATEWAY_DOWNLOAD=true
